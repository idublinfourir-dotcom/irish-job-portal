# Copy to .env.local in each app that needs it. Real values never go in the repo.

# Transaction pooler, port 6543. Used by the apps.
DATABASE_URL=
# Session pooler, port 5432. Used for migrations, because the direct connection is IPv6 only.
DATABASE_URL_MIGRATE=
# The database host's CA certificate. Without it, verified connections to the pooler fail.
DATABASE_CA_CERT=
# Local Postgres only. Refused in production.
# DATABASE_SSL=disable

BETTER_AUTH_SECRET=
BASE_URL=http://localhost:3000

# Tests only: the throwaway Postgres from `npm run db:test:up` (this is the default, so it is rarely needed).
# TEST_DATABASE_URL=postgres://postgres:test@127.0.0.1:54329/postgres

# Real email (8.1b). Both set: the apps and the outbox command send through Brevo. Neither: the local fake sender (localhost only; the apps
# refuse to start on Vercel or in production without them). Only one set: the apps refuse to start. The key is never logged.
# BREVO_API_KEY=
# EMAIL_FROM=no-reply@your-domain.example

# Cached pages (Stage 3): the candidate site's POST /api/revalidate and its callers (admin) sign with this, 32 or more characters, made by a
# local script, never typed. Unset: the route answers 503 and the callers send nothing.
# REVALIDATE_SECRET=

# Stored files (CVs and case documents), candidate and portal apps only: the S3 bucket and the app's own IAM key (get, put, delete and list
# on that bucket only). Any one missing: only the file routes answer 503, the rest of the app works. AWS_* names are never read (Vercel sets them).
# FILES_S3_KEY_ID=
# FILES_S3_SECRET=
# FILES_S3_BUCKET=irish-job-portal-files
# FILES_S3_REGION=eu-west-1
