# Copy to .env.local in each app that needs it. Real values never go in the repo.

# Transaction pooler, port 6543. Used by the apps.
DATABASE_URL=
# Session pooler, port 5432. Used for migrations, because the direct connection is IPv6 only.
DATABASE_URL_MIGRATE=
# The database host's CA certificate. Without it, verified connections to the pooler fail.
DATABASE_CA_CERT=
# Local Postgres only. Refused in production.
# DATABASE_SSL=disable

BETTER_AUTH_SECRET=
BASE_URL=http://localhost:3000
