{
  "name": "@portal/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./ssl": "./src/ssl.ts",
    "./rules-data": "./src/rules-data.ts",
    "./staff-tools": "./src/staff-tools.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "dete:import": "node src/dete-cli.ts import",
    "dete:link": "node src/dete-cli.ts link",
    "db:pull": "node test/pull-schema.mjs",
    "db:test:up": "sh test/test-db.sh up",
    "db:test:down": "sh test/test-db.sh down"
  },
  "dependencies": {
    "@portal/rules": "*",
    "@vercel/functions": "3.11.0",
    "aws4fetch": "1.0.20",
    "better-auth": "1.7.17",
    "botid": "1.5.13",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
  }
}
