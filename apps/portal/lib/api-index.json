{
  "name": "Portal API (employers and agencies)",
  "routes": {
    "portalApiIndex": "GET /api",
    "portalAuthGet": "GET /api/auth/portal/{path}",
    "portalAuthPost": "POST /api/auth/portal/{path}",
    "portalHealth": "GET /api/health",
    "getLegalText": "GET /api/legal",
    "portalCaseDocumentsList": "GET /api/portal/cases/{id}/documents (any active portal login)",
    "portalCaseDocumentsUpload": "POST /api/portal/cases/{id}/documents (any active portal login)",
    "portalCaseDocumentDownload": "GET /api/portal/cases/{id}/documents/{docId} (any active portal login)",
    "portalClaim": "POST /api/portal/claim (no company yet)",
    "portalClaimSearch": "GET /api/portal/claim/search (any active portal login)",
    "portalRegister": "POST /api/portal/register (no company yet)",
    "portalCompanyGet": "GET /api/portal/company (any member)",
    "portalCompanyEdit": "POST /api/portal/company (account_owner)",
    "portalCompanyClose": "POST /api/portal/company/close (account_owner)",
    "portalCompanyLogo": "PUT /api/portal/company/logo (account_owner)",
    "portalContact": "POST /api/portal/contact (any active portal login; anyone for topic appeal)",
    "portalReport": "POST /api/portal/report (any active portal login)",
    "portalReviewAnswer": "POST /api/portal/review-answer (account_owner)",
    "portalJobsList": "GET /api/portal/jobs (any member)",
    "portalJobCreate": "POST /api/portal/jobs (account_owner, recruiter, poster)",
    "portalJobEdit": "POST /api/portal/jobs/edit (account_owner, recruiter, poster)",
    "portalJobRenew": "POST /api/portal/jobs/renew (account_owner, recruiter, poster)",
    "portalJobClose": "POST /api/portal/jobs/close (account_owner, recruiter, poster)",
    "portalJobCheck": "POST /api/portal/jobs/check (account_owner, recruiter, poster)",
    "portalJobSuggest": "GET /api/portal/jobs/suggest (any active portal login)",
    "portalJobGrades": "GET /api/portal/jobs/grades (any active portal login)",
    "portalJobAuthorityList": "GET /api/portal/jobs/{id}/authority (account_owner, recruiter, poster)",
    "portalJobAuthorityUpload": "POST /api/portal/jobs/{id}/authority (account_owner, recruiter, poster)",
    "portalJobAuthorityDownload": "GET /api/portal/jobs/{id}/authority/{docId} (account_owner, recruiter, poster)",
    "portalJobStats": "GET /api/portal/job-stats (any member)",
    "portalNoticesList": "GET /api/portal/notices (any active portal login)",
    "portalNoticesMarkRead": "POST /api/portal/notices (any active portal login)",
    "portalNoticeSettingsGet": "GET /api/portal/notices/settings (any active portal login)",
    "portalNoticeSettingsPut": "PUT /api/portal/notices/settings (any active portal login)",
    "portalPayFloorsList": "GET /api/portal/pay-floors (any member)",
    "portalPayFloorsWrite": "POST /api/portal/pay-floors (account_owner, signer (poster or recruiter with the signer switch))",
    "portalStatusGet": "GET /api/portal/status (any member)",
    "portalStatusWrite": "POST /api/portal/status (account_owner)",
    "portalTeamGet": "GET /api/portal/team (any active portal login)",
    "portalTeamWrite": "POST /api/portal/team (invite, approve, refuse, remove, role, transfer: account_owner, accept, request: no company yet, leave: any member)",
    "portalAccountDelete": "DELETE /api/portal/account (any active portal login)",
    "portalAccountExport": "GET /api/portal/account/export (any active portal login)",
    "dataRequestInfo": "GET /api/data-request (anyone with the token)",
    "dataRequestConfirm": "POST /api/data-request (anyone with the token)"
  }
}
