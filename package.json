{
  "name": "irish-job-portal",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=24" },
  "scripts": {
    "dev:candidate": "npm run dev -w @portal/candidate",
    "dev:portal": "npm run dev -w @portal/portal",
    "dev:admin": "npm run dev -w @portal/admin",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings 0",
    "db:pull": "npm run db:pull -w @portal/db",
    "db:test:up": "npm run db:test:up -w @portal/db",
    "db:test:down": "npm run db:test:down -w @portal/db",
    "test": "vitest run",
    "test:perf": "vitest run --config packages/db/test/perf/vitest.config.ts --reporter=verbose",
    "test:mutation": "node packages/db/test/mutation/run.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
