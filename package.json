{
  "name": "irish-job-portal",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=24" },
  "scripts": {
    "dev:candidate": "npm run dev -w @portal/candidate",
    "dev:portal": "npm run dev -w @portal/portal",
    "dev:admin": "npm run dev -w @portal/admin",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^24",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
